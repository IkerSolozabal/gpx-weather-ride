#!/bin/sh
# Se ejecuta (con "source") antes de procesar las plantillas de nginx.
# Calcula las variables que necesita docker/nginx.conf.template.

: "${APP_ENV:=pro}"
: "${WEATHER_API_URL:=https://api.open-meteo.com/v1/forecast}"

# Origen de la API de meteo para la Content-Security-Policy (https://host[:puerto]).
WEATHER_ORIGIN=$(printf '%s' "$WEATHER_API_URL" | sed -E 's#^(https?://[^/?#]+).*#\1#')
# Origen de las teselas del mapa ({s}. → *.): el service worker las guarda para usarlas sin conexión.
: "${MAP_TILE_URL:=https://tile.openstreetmap.org/{z}/{x}/{y}.png}"
TILE_ORIGIN=$(printf '%s' "$MAP_TILE_URL" | sed -E -e 's#^(https?://[^/?#]+).*#\1#' -e 's#\{s\}#*#')
export CSP_CONNECT_SRC="'self' ${WEATHER_ORIGIN} ${TILE_ORIGIN}${CSP_EXTRA_CONNECT:+ $CSP_EXTRA_CONNECT}"

# Indexación: por defecto solo en producción.
if [ -z "${ROBOTS_INDEX:-}" ]; then
  if [ "$APP_ENV" = "pro" ]; then ROBOTS_INDEX=true; else ROBOTS_INDEX=false; fi
fi
export ROBOTS_INDEX
if [ "$ROBOTS_INDEX" = "true" ]; then
  export ROBOTS_HEADER="all"
else
  export ROBOTS_HEADER="noindex, nofollow"
fi

export APP_ENV WEATHER_API_URL
