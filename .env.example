# Copia como .env (no se sube a Git). Lo lee docker compose para puertos e imágenes.

# Producción: interfaz y puerto en la VM (127.0.0.1 = solo accesible desde el proxy inverso).
PRO_BIND=127.0.0.1
PRO_PORT=8080

# Preproducción
PRE_BIND=127.0.0.1
PRE_PORT=8081

# Imágenes. Por defecto, las que publica GitHub Actions. Puedes fijar una versión concreta,
# por ejemplo ghcr.io/ikersolozabal/gpx-weather-ride:sha-1a2b3c4 para volver atrás.
# PRO_IMAGE=ghcr.io/ikersolozabal/gpx-weather-ride:latest
# PRE_IMAGE=ghcr.io/ikersolozabal/gpx-weather-ride:pre
