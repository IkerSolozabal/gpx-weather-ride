# Configuración de la app en PRODUCCIÓN (gpx.sogra.es).
# Producción se publica en GitHub Pages: estas variables se crean en GitHub, en
# Settings → Secrets and variables → Actions → Variables, con el mismo nombre.
# Este archivo sirve de referencia y para el plan B (producción en Docker: cópialo como .env.pro).
# Todas son opcionales: si faltan, se usa el valor indicado.

# --- General ---
# Nombre que aparece en la cabecera y en la pestaña.
# APP_NAME=GPX Weather Ride
# Idioma inicial: es | en
# APP_DEFAULT_LANG=es
# Permitir que los buscadores indexen la web (por defecto true en pro y false en pre).
# ROBOTS_INDEX=true

# --- Meteo (Open-Meteo) ---
# URL de la API. Con plan de pago: https://customer-api.open-meteo.com/v1/forecast
# WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
# Clave de API (solo planes de pago). Ojo: viaja al navegador, cualquiera puede verla.
# WEATHER_API_KEY=
# Modelo meteorológico (vacío = el mejor disponible para cada zona). Ej.: ecmwf_ifs025, meteofrance_seamless
# WEATHER_MODELS=
# Días máximos de pronóstico que se permite elegir.
# WEATHER_FORECAST_DAYS=16

# --- Mapa ---
# Teselas del mapa. Por defecto OpenStreetMap (uso moderado; para mucho tráfico usa otro proveedor).
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
# MAP_MAX_ZOOM=19

# --- Cálculo de la ruta ---
# Cada cuántos km se pide la meteo (más bajo = más detalle y más consultas).
# ROUTE_SAMPLE_KM=2
# Máximo de puntos de meteo por ruta (si se supera, se amplía el paso).
# ROUTE_MAX_SAMPLES=150
# Longitud de los tramos coloreados por viento, en metros.
# ROUTE_SEGMENT_M=250
# Tamaño máximo del GPX, en MB.
# GPX_MAX_FILE_MB=10

# --- Valores por defecto del formulario ---
# Deporte inicial: bike | run
# DEFAULT_SPORT=bike
# BIKE_SPEED_KMH=25
# RUN_PACE=5:30
# Distancia entre puntos kilométricos en mapa y tabla.
# BIKE_MARKER_KM=5
# RUN_MARKER_KM=1

# --- Clasificación del viento ---
# Por debajo de esta velocidad (km/h) se considera calma.
# WIND_CALM_KMH=5
# Ángulo máximo respecto al frente para "en contra" y mínimo para "a favor" (grados).
# WIND_HEAD_ANGLE=45
# WIND_TAIL_ANGLE=135

# --- Seguridad ---
# Orígenes extra permitidos en connect-src de la CSP, separados por espacios.
# CSP_EXTRA_CONNECT=
